<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Doris09210.Cardline.Windows</id>
    <version>0.0.0</version>
    <title>Cardline · 截图晾衣绳 Windows 版</title>
    <authors>Alejandro Buján (Tendedero original author), jiuyang5354 (Snapline Windows implementation), Doris09210 (Cardline theme)</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <readme>README.md</readme>
    <projectUrl>https://github.com/Doris09210/snapline-windows</projectUrl>
    <description>Windows screenshot shelf with custom hotkeys, update notifications, pause collection, quick copy and optional startup. Unofficial Windows implementation of Tendedero by Alejandro Buján. Requires Windows 10/11 and .NET Framework 4.8. Run tools/Cardline/Cardline.exe after extracting the full tools/Cardline directory. This package distributes a desktop application.</description>
    <copyright>Copyright (c) 2026 Alejandro Buján; Copyright (c) 2026 jiuyang5354 (Snapline Windows implementation); Copyright (c) 2026 Doris09210 (Cardline)</copyright>
    <tags>windows screenshot clipboard desktop snapline</tags>
    <repository type="git" url="https://github.com/Doris09210/snapline-windows" commit="" />
  </metadata>
  <files>
    <file src="PACKAGE-README.md" target="README.md" />
    <file src="portable/LICENSE" target="LICENSE" />
    <file src="portable/UPSTREAM-LICENSE.txt" target="UPSTREAM-LICENSE.txt" />
    <file src="portable/NOTICE.md" target="NOTICE.md" />
    <file src="portable/Cardline.exe" target="tools/Cardline" />
    <file src="portable/Cardline.exe.config" target="tools/Cardline" />
    <file src="portable/README.zh-CN.md" target="tools/Cardline" />
    <file src="portable/LICENSE" target="tools/Cardline/LICENSE" />
    <file src="portable/UPSTREAM-LICENSE.txt" target="tools/Cardline" />
    <file src="portable/NOTICE.md" target="tools/Cardline" />
    <file src="portable/QA.md" target="tools/Cardline" />
    <file src="portable/preview.png" target="tools/Cardline" />
    <file src="portable/PDF-TOOLS-PLAN.zh-CN.md" target="tools/Cardline" />
    <file src="portable\Converters\**\*" target="tools\Cardline\Converters" />
  </files>
</package>
